# Copy to .env.local (git-ignored) for local development, and set the same two variables in your host (e.g. Vercel).
# Both values are PUBLIC by design (they ship to every browser); Supabase row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Match your database region to reduce function-to-database round trips; omit or use "any" for automatic routing.
VITE_SUPABASE_FUNCTION_REGION=ap-south-1
